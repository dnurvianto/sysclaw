# ==============================================================================
# SysClaw Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Allowed Telegram Chat IDs (comma-separated, get from @userinfobot)
# SysClaw will silently drop messages from any Chat ID not in this list.
ALLOWED_CHAT_IDS=8279738173

# AI Provider Settings
# Default: deepseek
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
AI_MODEL=deepseek-chat

# Max Context Memory (number of recent message exchanges kept in RAM)
MAX_MEMORY_TURNS=10
